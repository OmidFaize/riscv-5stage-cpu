06400093  // 0x00  addi x1, x0, 100
00700113  // 0x04  addi x2, x0, 7
002081b3  // 0x08  add  x3, x1, x2       # RAW both ops: x2 EX/MEM, x1 MEM/WB
00500213  // 0x0c  addi x4, x0, 5
404182b3  // 0x10  sub  x5, x3, x4       # x3 MEM/WB, x4 EX/MEM
00228333  // 0x14  add  x6, x5, x2       # back-to-back RAW on x5
04d00393  // 0x18  addi x7, x0, 77
00702023  // 0x1c  sw   x7, 0(x0)        # STORE-DATA forwarding
00002403  // 0x20  lw   x8, 0(x0)
002404b3  // 0x24  add  x9, x8, x2       # LOAD-USE STALL
05800513  // 0x28  addi x10, x0, 88
00a02223  // 0x2c  sw   x10, 4(x0)       # STORE-DATA forwarding
00402583  // 0x30  lw   x11, 4(x0)
00a58663  // 0x34  beq  x11, x10, 0x40   # LOAD-USE STALL on branch operand, then TAKEN
4bc00613  // 0x38  addi x12, x0, 1212    # flushed
52100693  // 0x3c  addi x13, x0, 1313    # flushed
08c00713  // 0x40  addi x14, x0, 140     # branch target
002707b3  // 0x44  add  x15, x14, x2     # forwarding immediately after flush
00211663  // 0x48  bne  x2, x2, 0x54     # NOT taken
0a000813  // 0x4c  addi x16, x0, 160     # executes
0aa00893  // 0x50  addi x17, x0, 170     # executes
0b400913  // 0x54  addi x18, x0, 180
00208033  // 0x58  add  x0, x1, x2       # write to x0 must be discarded
001009b3  // 0x5c  add  x19, x0, x1      # x0 GUARD: must read 0, not 107
00002a03  // 0x60  lw   x20, 0(x0)
0d200a93  // 0x64  addi x21, x0, 210     # independent -> NO stall
015a0b33  // 0x68  add  x22, x20, x21    # x20 MEM/WB + x21 EX/MEM, no stall
06300b93  // 0x6c  addi x23, x0, 99
01702423  // 0x70  sw   x23, 8(x0)       # mem[8] = 99
00800c13  // 0x74  addi x24, x0, 8       # equals the LOAD ADDRESS, not the data
00802c83  // 0x78  lw   x25, 8(x0)       # data=99, address=8
018c8663  // 0x7c  beq  x25, x24, 0x88   # stale rs1=8 == 8 -> TAKEN (wrong)
10400d13  // 0x80  addi x26, x0, 260     # must execute
10e00d93  // 0x84  addi x27, x0, 270     # must execute
11800e13  // 0x88  addi x28, x0, 280     # branch target
